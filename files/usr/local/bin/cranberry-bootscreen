#!/bin/sh
# cranberry-bootscreen
# Se ejecuta en lugar de getty en tty1. Muestra el ASCII art + barra de
# progreso UNA sola vez por arranque (usa /run, que es tmpfs y se limpia
# en cada reboot), y despues cede el lugar al getty real para el login.

if [ ! -f /run/cranberry-bootscreen-shown ]; then
    touch /run/cranberry-bootscreen-shown

    clear
    cat << 'EOF'

  ____ ____      _    _   _ ____  _____ ____  ______   __
 / ___|  _ \    / \  | \ | | __ )| ____|  _ \|  _ \ \ / /
| |   | |_) |  / _ \ |  \| |  _ \|  _| | |_) | |_) \ V /
| |___|  _ <  / ___ \| |\  | |_) | |___|  _ <|  _ < | |
 \____|_| \_\/_/   \_\_| \_|____/|_____|_| \_\_| \_\|_|

EOF

    echo "                    Iniciando Cranberry OS..."
    echo

    i=1
    while [ "$i" -le 100 ]; do
        filled=$((i / 5))
        bar=""
        j=1
        while [ "$j" -le 20 ]; do
            if [ "$j" -le "$filled" ]; then
                bar="${bar}#"
            else
                bar="${bar}-"
            fi
            j=$((j + 1))
        done
        printf "\r                    [%s] %3d%%" "$bar" "$i"
        i=$((i + 1))
        sleep 0.03
    done

    echo
    sleep 0.5
    clear
fi

exec /sbin/getty 38400 tty1
