#!/usr/bin/env python3
"""
cranberry-launcherd
Escucha en 127.0.0.1:4001 y lanza programas reales cuando el shell HTML
(index.html) pide, por ejemplo, GET /launch?app=firefox

Solo escucha en localhost (127.0.0.1), no en la red, para no exponer
esto a otras maquinas.
"""
import subprocess
from http.server import BaseHTTPRequestHandler, HTTPServer
from urllib.parse import urlparse, parse_qs

APPS = {
    "firefox": ["firefox-esr", "--new-window"],
    "files": ["pcmanfm"],
    "terminal": ["xterm"],
    "install": ["xterm", "-T", "Instalador de Cranberry OS",
                "-e", "/usr/local/bin/cranberry-install"],
}


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        parsed = urlparse(self.path)
        if parsed.path == "/launch":
            params = parse_qs(parsed.query)
            app = params.get("app", [""])[0]
            cmd = APPS.get(app)
            if cmd:
                subprocess.Popen(cmd)
                self.send_response(200)
            else:
                self.send_response(404)
        else:
            self.send_response(404)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()

    def log_message(self, format, *args):
        pass  # silencioso, no ensucia la consola


if __name__ == "__main__":
    server = HTTPServer(("127.0.0.1", 4001), Handler)
    server.serve_forever()
